# Booking API
# Leave blank when the frontend is served from the same origin as /api.
# Set to an API Gateway origin for local development without a CRA proxy.
REACT_APP_BOOKING_API_BASE_URL=

# CAPTCHA (Google reCAPTCHA v3)
# Public site key — safe to expose in the browser bundle.
# Obtain from the Google reCAPTCHA admin console (v3 site key).
# Must be issued by the same provider as booking-api's CAPTCHA_PROVIDER.
# Leave blank to disable the CAPTCHA widget entirely.
# The backend triggers a challenge by returning 403 with error code captcha_required.
# In CI, set REACT_APP_CAPTCHA_SITE_KEY as a GitHub Actions secret (or repository variable).
REACT_APP_CAPTCHA_SITE_KEY=

# Existing public browser config
REACT_APP_SMOOBU_URL=
REACT_APP_HOUSE_CODES=
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_META_PIXEL_ID=
REACT_APP_META_PIXEL_ENABLED=true
REACT_APP_META_PIXEL_DEBUG=false
REACT_APP_GA4_SMOOBU_TRACKING_ENABLED=true
REACT_APP_GA4_SMOOBU_TRACKING_DEBUG=false
REACT_APP_GA4_SMOOBU_VISIBILITY_THRESHOLD=3000
REACT_APP_PUBLIC_POSTHOG_KEY=
REACT_APP_PUBLIC_POSTHOG_HOST=
