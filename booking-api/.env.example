# Booking API non-secret config
BOOKING_API_ALLOWED_ORIGINS=https://www.kalawalarentals.com,https://kalawalarentals.com
BOOKING_API_MAX_BODY_BYTES=65536
BOOKING_API_ABUSE_PROTECTION_ENABLED=true
BOOKING_API_CAPTCHA_CHALLENGES_ENABLED=true
BOOKING_API_RATE_LIMIT_MAX_BUCKETS=10000

# PayPal API config. Use sandbox URL for non-production environments.
# Return/cancel URLs are only required for the redirect flow; leave empty when using the JS SDK.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=10000
PAYPAL_ORDER_RETURN_URL=
PAYPAL_ORDER_CANCEL_URL=

# Smoobu customer/user ID — required for POST /api/search availability checks.
SMOOBU_CUSTOMER_ID=

# Production/staging/dev deployments should point to AWS Secrets Manager.
# The Lambda runtime also needs the AWS Parameters and Secrets Lambda Extension
# and IAM permission to read this secret.
BOOKING_API_SECRETS_MANAGER_SECRET_ID=kalawala/dev/booking-api
BOOKING_API_SECRETS_CACHE_TTL_MS=300000
BOOKING_API_SECRETS_FETCH_TIMEOUT_MS=2000

# Local-only escape hatch for isolated tests. Never use for deployed envs.
# BOOKING_API_ALLOW_INSECURE_ENV_SECRETS=true
# BOOKING_API_SECRETS_JSON={"smoobuApiKey":"...","paypalClientId":"...","paypalClientSecret":"...","paypalWebhookId":"...","smoobuWebhookSecret":"...","bookingEncryptionKeyBase64":"...","portalSessionSecret":"..."}
