{
  "name": "@kalawala/booking-api",
  "version": "0.1.0",
  "private": true,
  "description": "AWS Lambda booking API scaffold for Kalawala's Smoobu-backed booking engine.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@aws-sdk/client-ses": "^3.1030.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9"
  }
}
