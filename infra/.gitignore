# Terraform state — NEVER commit state files; use S3 + DynamoDB remote backend.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output files
*.tfplan

# Local backend override file — environment-specific, not shared
backend.hcl

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Sensitive variable overrides (use environments/*.tfvars for committed values)
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash log
crash.log
crash.*.log

# Lambda build artefacts (generated by Terraform archive_file data source)
lambda/*.zip
