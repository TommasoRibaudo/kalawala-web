{
  "name": "kalawala-web",
  "version": "0.1.0",
  "private": true,
  "homepage": "/",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@react-hook/media-query": "^1.1.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.12",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "babel-plugin-macros": "^2.4.2",
    "bootstrap": "^5.2.3",
    "country-flag-icons": "^1.5.13",
    "posthog-js": "^1.365.4",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.2",
    "react-dom": "^18.2.0",
    "react-google-recaptcha-v3": "^1.10.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "react-slick": "^0.30.2",
    "sass": "^1.77.8",
    "slick-carousel": "^1.8.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false react-scripts build",
    "postbuild": "react-snap && node scripts/generate-404.js && node scripts/generate-redirects.js && node scripts/inject-route-preloads.js && node scripts/generate-sitemap.js && node scripts/generate-md-pages.js && node scripts/generate-llms-full.js",
    "build-local": "cross-env DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "booking-api:build": "npm --prefix booking-api run build",
    "booking-api:migrate": "npm --prefix booking-api run migrate",
    "booking-api:typecheck": "npm --prefix booking-api run typecheck",
    "booking-api:test": "npm --prefix booking-api run test",
    "lh": "node scripts/lighthouse-run.mjs",
    "lh:desktop": "node scripts/lighthouse-run.mjs --desktop",
    "analyze": "source-map-explorer \"build/static/js/*.js\" --no-border-checks",
    "test": "react-scripts test",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "eject": "react-scripts eject",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:migrate": "npm --prefix booking-api run migrate:local",
    "local:api": "npm --prefix booking-api run dev"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bonjour": "^3.5.13",
    "@types/express": "^4.17.25",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/q": "^1.5.8",
    "@types/react-helmet": "^6.1.11",
    "@types/react-slick": "^0.23.13",
    "@types/serve-static": "^2.2.0",
    "cross-env": "^10.1.0",
    "lighthouse": "^12.8.2",
    "react-snap": "^1.23.0",
    "require-context.macro": "^1.2.2",
    "serve": "^14.2.6",
    "source-map-explorer": "^2.5.3"
  },
  "overrides": {
    "serialize-javascript": "6.0.2",
    "underscore": "1.13.8",
    "minimist": "^1.2.8"
  },
  "reactSnap": {
    "source": "build",
    "minifyHtml": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": true,
    "headless": true,
    "crawl": false,
    "include": [
      "/",
      "/404",
      "/en/geco",
      "/en/rana",
      "/en/tucano",
      "/en/pappagallo",
      "/en/delfin",
      "/en/areka",
      "/en/giulia",
      "/en/plumeria",
      "/en/villamar",
      "/en/villacoral",
      "/en/blog",
      "/en/twodaysinpuertoviejo",
      "/en/gettingtogandoca",
      "/en/travellingtopuertoviejo",
      "/en/puertoviejobyplane",
      "/en/tenhoursinpuerto",
      "/en/bushours",
      "/en/cahuitaparkwhattodo",
      "/en/indigenoustravelpv",
      "/en/besttimetovisitpuerto",
      "/en/puertohiddengems",
      "/es/",
      "/es/geco",
      "/es/rana",
      "/es/tucano",
      "/es/pappagallo",
      "/es/delfin",
      "/es/areka",
      "/es/giulia",
      "/es/plumeria",
      "/es/villamar",
      "/es/villacoral",
      "/es/blog",
      "/es/twodaysinpuertoviejo",
      "/es/gettingtogandoca",
      "/es/travellingtopuertoviejo",
      "/es/puertoviejobyplane",
      "/es/tenhoursinpuerto",
      "/es/bushours",
      "/es/cahuitaparkwhattodo",
      "/es/indigenoustravelpv",
      "/es/besttimetovisitpuerto",
      "/es/puertohiddengems"
    ]
  },
  "proxy": "http://localhost:4000"
}
